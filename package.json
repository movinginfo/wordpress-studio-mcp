{
  "name": "wordpress-studio-mcp",
  "version": "0.1.13",
  "description": "Hybrid MCP extension for WordPress Studio 1.7.7 — filesystem, SQLite DB, WP-CLI, REST API, security audit, wp-config management, VIP Design System, custom domain mapping, and mkcert HTTPS",
  "type": "module",
  "bin": {
    "wordpress-studio-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "glob": "^10.3.10",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
